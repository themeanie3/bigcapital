# Environment for docker-compose.dokploy.yml.
# Paste the filled-in contents into the Dokploy service's "Environment" tab.
# Generate secrets with the commands in the comments; never commit real values.

# --- Required -----------------------------------------------------------------
# Public URL Dokploy serves the app on (must match the Domain configured in Dokploy).
BASE_URL=https://books.example.com

# openssl rand -base64 48
APP_JWT_SECRET=

# Database (MariaDB container)
DB_USER=bigcapital
# openssl rand -base64 24
DB_PASSWORD=
# openssl rand -base64 24
DB_ROOT_PASSWORD=
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# ClickHouse (container is always started; analytics only used when enabled)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_USER=default
# openssl rand -base64 32
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=bigcapital_analytics

# Garage object storage (attachments / documents)
# openssl rand -hex 32   (must be 64 hex chars)
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
S3_REGION=garage
S3_ENDPOINT=http://garage:3900
S3_BUCKET=bigcapital
S3_FORCE_PATH_STYLE=true
# Filled in AFTER first deploy by running the Garage bootstrap (see docs/dokploy.md):
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Sign-up ------------------------------------------------------------------
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# --- Mail (needed for invites / password reset / email confirmation) ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Bigcapital
MAIL_FROM_ADDRESS=

# --- Optional integrations ----------------------------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

BANK_FEED_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=

STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=https://books.example.com/preferences/payment-methods/stripe/callback

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
HOSTED_ON_BIGCAPITAL_CLOUD=false

POSTHOG_API_KEY=
POSTHOG_HOST=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=false
NEW_RELIC_LOG=stdout
NEW_RELIC_AI_MONITORING_ENABLED=false
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=

# --- Rate limiting ------------------------------------------------------------
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30
